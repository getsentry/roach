{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The Roach Worker: a remote store for recordings. See "Worker" in
  // README.md.
  "name": "roach",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // The Sentry SDK needs AsyncLocalStorage.
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  // ROACH_TENANTS is a secret: `wrangler secret put ROACH_TENANTS`.
  // SENTRY_DSN is an optional secret too.
  "secrets": { "required": ["ROACH_TENANTS"] },
  // A lifecycle rule on the bucket deletes recordings after 30 days.
  "r2_buckets": [
    { "binding": "RECORDINGS", "bucket_name": "roach-recordings" },
  ],
}
