{
  "name": "@sentry/roach",
  "version": "0.2.0",
  "description": "A recording HTTPS proxy for tests, as a shared service.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getsentry/roach.git"
  },
  "files": [
    "src/client.ts",
    "src/config.ts",
    "src/report.ts",
    "src/types.ts",
    "src/values.ts",
    "src/vitest-setup.ts",
    "src/vitest.ts"
  ],
  "type": "module",
  "exports": {
    "./client": "./src/client.ts",
    "./report": "./src/report.ts",
    "./types": "./src/types.ts",
    "./values": "./src/values.ts",
    "./vitest": "./src/vitest.ts",
    "./vitest/setup": "./src/vitest-setup.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm knip && pnpm test",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "prepare": "simple-git-hooks",
    "skills:install": "dotagents --project install",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@sentry/dotagents": "^3.3.0",
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "^5.0.3",
    "knip": "^6.40.0",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^7.0.2",
    "undici": "^8.11.2",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "vitest": ">=3"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged",
    "pre-push": "pnpm typecheck"
  },
  "lint-staged": {
    "*.{ts,mts,js,mjs}": [
      "oxlint --fix --deny-warnings",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,md,yml,yaml}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.8.0"
}
