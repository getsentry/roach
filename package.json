{
  "name": "roach",
  "private": true,
  "description": "The workspace of @sentry/roach and the Roach service.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm knip && pnpm test",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "prepare": "simple-git-hooks",
    "skills:install": "dotagents --project install",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p . && pnpm -r typecheck"
  },
  "devDependencies": {
    "@sentry/dotagents": "^3.3.0",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "^5.0.3",
    "knip": "^6.40.0",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "simple-git-hooks": "^2.14.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged",
    "pre-push": "pnpm typecheck"
  },
  "lint-staged": {
    "*.{ts,mts,js,mjs}": [
      "oxlint --fix --deny-warnings",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,md,yml,yaml}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.8.0"
}
